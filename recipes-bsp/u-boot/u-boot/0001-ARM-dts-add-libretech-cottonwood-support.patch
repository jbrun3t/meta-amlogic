From b9f36b8ac589cdab18d7cd61b905051852dc1aa1 Mon Sep 17 00:00:00 2001
From: Jerome Brunet <jbrunet@baylibre.com>
Date: Tue, 18 Jul 2023 14:52:19 +0200
Subject: [PATCH] ARM: dts: add libretech cottonwood support

Add support for libretech CC devices based on the S905D3 and A311D

Signed-off-by: Jerome Brunet <jbrunet@baylibre.com>
Upstream-Status: Pending
---
 .../meson-g12b-a311d-libretech-cc-u-boot.dtsi |  30 ++++++
 .../meson-libretech-cottonwood-u-boot.dtsi    |  23 ++++
 .../meson-sm1-s905d3-libretech-cc-u-boot.dtsi |  30 ++++++
 configs/libretech-a311d-cc_defconfig          | 100 ++++++++++++++++++
 configs/libretech-s905d3-cc_defconfig         | 100 ++++++++++++++++++
 5 files changed, 283 insertions(+)
 create mode 100644 arch/arm/dts/meson-g12b-a311d-libretech-cc-u-boot.dtsi
 create mode 100644 arch/arm/dts/meson-libretech-cottonwood-u-boot.dtsi
 create mode 100644 arch/arm/dts/meson-sm1-s905d3-libretech-cc-u-boot.dtsi
 create mode 100644 configs/libretech-a311d-cc_defconfig
 create mode 100644 configs/libretech-s905d3-cc_defconfig

diff --git a/arch/arm/dts/meson-g12b-a311d-libretech-cc-u-boot.dtsi b/arch/arm/dts/meson-g12b-a311d-libretech-cc-u-boot.dtsi
new file mode 100644
index 000000000000..17703289562f
--- /dev/null
+++ b/arch/arm/dts/meson-g12b-a311d-libretech-cc-u-boot.dtsi
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 BayLibre, SAS
+ * Author: Jerome Brunet <jbrunet@baylibre.com>
+ */
+
+#include "meson-libretech-cottonwood-u-boot.dtsi"
+
+/ {
+	smbios {
+		compatible = "u-boot,sysinfo-smbios";
+
+		smbios {
+			system {
+				manufacturer = "libre-computer";
+				product = "aml-a311d-cc";
+			};
+
+			baseboard {
+				manufacturer = "libre-computer";
+				product = "aml-a311d-cc";
+			};
+
+			chassis {
+				manufacturer = "libre-computer";
+				product = "aml-a311d-cc";
+			};
+		};
+	};
+};
diff --git a/arch/arm/dts/meson-libretech-cottonwood-u-boot.dtsi b/arch/arm/dts/meson-libretech-cottonwood-u-boot.dtsi
new file mode 100644
index 000000000000..49e0deef3b19
--- /dev/null
+++ b/arch/arm/dts/meson-libretech-cottonwood-u-boot.dtsi
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 BayLibre, SAS
+ * Author: Jerome Brunet <jbrunet@baylibre.com>
+ */
+
+#include "meson-g12-common-u-boot.dtsi"
+
+/ {
+	aliases {
+		spi0 = &spifc;
+	};
+};
+
+&sd_emmc_c {
+	status = "okay";
+	pinctrl-0 = <&emmc_ctrl_pins>, <&emmc_data_4b_pins>;
+	bus-width = <4>;
+};
+
+&spifc {
+	status = "okay";
+};
diff --git a/arch/arm/dts/meson-sm1-s905d3-libretech-cc-u-boot.dtsi b/arch/arm/dts/meson-sm1-s905d3-libretech-cc-u-boot.dtsi
